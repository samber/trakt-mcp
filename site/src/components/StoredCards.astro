---
import { NEVER_STORED, STORED } from '../data/site';
---

<section class="stored" aria-labelledby="stored-title">
  <div class="wrap inner">
    <div class="head reveal">
      <h2 id="stored-title">
        Privacy first: we don't store your viewing history.{' '}
        <span class="soft">Every call goes straight to Trakt.</span>
      </h2>
      <p class="muted">
        The server keeps only what it needs to keep you signed in. It reads and writes your watchlist, history and
        ratings through the Trakt API, on your behalf.
      </p>
      <p><a href="/privacy">Read the privacy policy →</a></p>
    </div>
    <div class="lists">
      <div class="list never reveal">
        <h3>Never kept</h3>
        <ul>{NEVER_STORED.map((item) => <li>{item}</li>)}</ul>
      </div>
      <div class="list kept reveal">
        <h3>What the server keeps to sign you in</h3>
        <ul>{STORED.map((item) => <li>{item}</li>)}</ul>
      </div>
    </div>
  </div>
</section>

<style>
  .stored {
    padding-block: var(--space-7);
    background: var(--surface);
  }

  .inner {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 60rem) {
    .inner {
      grid-template-columns: 1fr 1.1fr;
      gap: var(--space-6);
      align-items: start;
    }

    .head {
      position: sticky;
      top: var(--space-5);
    }
  }

  .head {
    display: grid;
    gap: var(--space-3);
  }

  .head a {
    font-weight: 600;
  }

  .lists {
    display: grid;
    gap: var(--space-3);
  }

  .list {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--radius);
    background: var(--card);
    box-shadow: var(--shadow);
  }

  /* The promise is the point of the section: red heading and marks. */
  .never {
    box-shadow:
      inset 0 3px 0 var(--red),
      var(--shadow-lg);
  }

  .never h3 {
    color: var(--red);
  }

  ul {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    padding-left: 1.5rem;
  }

  li::before {
    position: absolute;
    left: 0;
    font-weight: 700;
  }

  .never li::before {
    content: '×';
    color: var(--red);
  }

  .kept li {
    color: var(--muted);
  }

  .kept li::before {
    content: '✓';
    color: var(--muted);
    font-size: 0.9em;
  }
</style>
