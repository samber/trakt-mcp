---
import { REPO_URL, SECURITY_URL, SELF_HOSTING_URL } from '../data/site';
import ConnectorUrl from './ConnectorUrl.astro';
---

<!-- The one dark section: the page ends on the action. Navy in both themes. -->
<section id="connect" class="closing" aria-labelledby="connect-title">
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap inner">
    <div class="steps-block">
      <h2 id="connect-title" class="reveal">
        Connect Trakt to Claude or ChatGPT.{' '}
        <span class="soft">One minute, no install, no API key.</span>
      </h2>
      <ol class="steps">
        <li class="reveal">
          <h3 id="step-copy">Copy the URL</h3>
          <div class="step-body">
            <ConnectorUrl id="closing-url" labelledBy="step-copy" />
          </div>
        </li>
        <li class="reveal">
          <h3>Add it to your assistant</h3>
          <p>
            Claude: Settings, Connectors, Add custom connector.<br />
            ChatGPT: turn on developer mode, then Create app.
          </p>
        </li>
        <li class="reveal">
          <h3>Sign in with Trakt</h3>
          <p>Approve access to your Trakt account. You can revoke it at any time in Trakt, under Settings, Connected Apps.</p>
        </li>
      </ol>
    </div>
    <div class="oss reveal">
      <h2 class="oss-title">An open source MCP server. Run your own if you prefer.</h2>
      <p>
        It speaks the Model Context Protocol (MCP) and runs remotely, so there is nothing to install. Anyone can read
        the code that touches your Trakt account. Developers can run their own copy.
      </p>
      <a class="button mint" href={REPO_URL}>Source code on GitHub</a>
      <p class="doc-links">
        <a href={SELF_HOSTING_URL}>Self-hosting guide</a> · <a href={SECURITY_URL}>Security notes</a>
      </p>
    </div>
  </div>
</section>

<style>
  .closing {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-bottom: calc(-1 * var(--space-7));
    padding-block: var(--space-7);
    background: var(--navy);
    color: var(--on-navy);
    scroll-margin-top: 0;
  }

  /* The hero's gradient, faint, rising from the top right corner. */
  .glow {
    position: absolute;
    z-index: -1;
    top: -40%;
    right: -20%;
    width: 70%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, var(--g3), var(--g2) 35%, var(--g1) 55%, transparent 70%);
    filter: blur(80px);
    opacity: 0.45;
  }

  .inner {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 60rem) {
    .inner {
      grid-template-columns: 1.3fr 1fr;
      align-items: end;
    }
  }

  .steps-block {
    display: grid;
    gap: var(--space-5);
  }

  .soft,
  p {
    color: var(--on-navy-muted);
  }

  .steps {
    position: relative;
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  /* The thread linking the three steps, behind the numbered badges. */
  .steps::before {
    content: '';
    position: absolute;
    top: 1.25rem;
    bottom: 1.25rem;
    left: calc(1.25rem - 1px);
    width: 2px;
    background: linear-gradient(var(--g1), var(--g3), var(--g5));
    transform-origin: top;
  }

  .steps li {
    position: relative;
  }

  .steps li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    column-gap: var(--space-3);
    counter-increment: step;
  }

  /* Numbered badges in the gradient's colours, in order. */
  .steps li::before {
    content: counter(step);
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--g1);
    color: var(--on-blue);
    font-weight: 700;
  }

  .steps li:nth-child(2)::before {
    background: var(--g3);
  }

  .steps li:nth-child(3)::before {
    background: var(--mint);
    color: var(--on-mint);
  }

  .steps h3 {
    font-size: var(--step-0);
    align-self: center;
  }

  .step-body {
    margin-top: var(--space-2);
    max-width: 36rem;
  }

  /* Hyperframes "svg-path-draw" and "spring-pop-entrance", scroll-linked: the thread
     draws down and each number springs in as the thread reaches it. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .steps::before {
        animation: grow-down linear both;
        animation-timeline: view();
        animation-range: entry 40% cover 50%;
      }

      .steps li::before {
        animation: badge-in linear both;
        animation-timeline: view();
        animation-range: entry 30% entry 90%;
      }
    }
  }

  @keyframes grow-down {
    from {
      transform: scaleY(0);
    }
  }

  @keyframes badge-in {
    0% {
      opacity: 0;
      transform: scale(0.4);
    }
    65% {
      opacity: 1;
      transform: scale(1.15);
    }
    100% {
      transform: scale(1);
    }
  }

  .oss {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.05);
  }

  .doc-links a {
    color: var(--on-navy);
    text-decoration: underline;
  }

  .oss-title {
    font-size: var(--step-2);
  }
</style>
