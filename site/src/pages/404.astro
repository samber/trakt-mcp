---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found | Trakt MCP"
  description="This page does not exist."
  path="/404"
  noindex
>
  <div class="wrap lost">
    <p class="code mono">404</p>
    <h1>Page not found</h1>
    <p class="muted">Nothing lives at this address.</p>
    <a class="button" href="/">Go to the home page</a>
  </div>
</Base>

<style>
  .lost {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    max-width: 36rem;
    padding-block: var(--space-7) 0;
  }

  .code {
    color: var(--red);
    font-weight: 600;
  }

  h1 {
    font-size: var(--step-3);
  }
</style>
