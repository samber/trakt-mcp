---
import Base from './Base.astro';
import { SITE_NAME, SITE_URL } from '../data/site';

type Props = {
  /** Page title and h1, for example "Privacy policy". */
  title: string;
  description: string;
  path: string;
  /** Date of the last change, YYYY-MM-DD. */
  updated: string;
};

const { title, description, path, updated } = Astro.props;
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: SITE_NAME, item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: title, item: new URL(path, SITE_URL).href },
  ],
};
const displayDate = new Date(`${updated}T00:00:00Z`).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<Base title={`${title} | ${SITE_NAME}`} description={description} path={path}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
  <div class="wrap legal">
    <header class="title">
      <h1>{title}</h1>
      <p class="muted">Last updated <time datetime={updated}>{displayDate}</time></p>
    </header>
    <article class="doc">
      <slot />
    </article>
  </div>
</Base>

<style>
  .legal {
    display: grid;
    gap: var(--space-5);
    max-width: 48rem;
    padding-block: var(--space-6) 0;
  }

  .title {
    display: grid;
    gap: var(--space-2);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--line);
  }

  h1 {
    font-size: var(--step-3);
  }

  .title p {
    font-size: var(--step--1);
  }

  /* Long-form text: the rules reach slotted content, so they are global but scoped to .doc. */
  .doc :global(h2) {
    margin-top: var(--space-5);
    font-size: var(--step-1);
  }

  .doc :global(h2:first-child) {
    margin-top: 0;
  }

  .doc :global(p),
  .doc :global(ul) {
    margin-top: var(--space-3);
    max-width: var(--measure-text);
  }

  .doc :global(ul) {
    display: grid;
    gap: var(--space-2);
    padding-left: 1.2rem;
  }

  .doc :global(li::marker) {
    color: var(--muted);
  }

  .doc :global(a) {
    text-decoration-color: var(--red);
  }

  .doc :global(h2 + p),
  .doc :global(h2 + ul) {
    margin-top: var(--space-2);
  }
</style>
